GPTONTO_API_KEY=replace-with-a-strong-secret
LLM_MODEL=your-model
LLM_BINDING_HOST=http://your-server:3000/v1
LLM_BINDING_API_KEY=your-key
GPTONTO_LLM_CONCURRENCY=4
GPTONTO_DOCUMENT_CONCURRENCY=2
GPTONTO_LLM_TIMEOUT=120
# Required only for V chunking
# EMBEDDING_MODEL=your-embedding-model
# EMBEDDING_DIM=1024
# EMBEDDING_BINDING_HOST=http://your-server:3000/v1
# EMBEDDING_BINDING_API_KEY=your-key

# Optional external document parsers (configure only services you trust)
# MINERU_API_MODE=local
# MINERU_LOCAL_ENDPOINT=http://mineru:8000
# DOCLING_ENDPOINT=http://docling:5001

GPTONTO_LLM_CACHE=true
GPTONTO_LLM_QUEUE_SIZE=1000

# Optional multimodal analysis (OpenAI compatible)
# VLM_MODEL=your-vision-model
# VLM_BINDING_HOST=http://your-vlm/v1
# VLM_BINDING_API_KEY=your-key
GPTONTO_ARTIFACT_MAX_BYTES=134217728

# Original LightRAG parser/chunker settings can be reused when not overridden in upload.
# LIGHTRAG_PARSER=...
# CHUNK_R_SIZE=1200
# CHUNK_R_OVERLAP_SIZE=100
# EDP_DEFAULT_PROFILE=week_report_tmp
# GPTONTO_EDP_PROFILES_DIR=/app/lightrag/lightrag/edp/profiles
